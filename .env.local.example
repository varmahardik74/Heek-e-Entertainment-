NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-side only (never exposed to the browser).
# The email of the single account allowed to access /admin and /api/admin/*.
ADMIN_EMAIL="your-admin-email@example.com"

# Server-side only (never exposed to the browser). Contact notification email.
# RESEND_FROM_EMAIL: sender address. onboarding@resend.dev works without a
# custom domain for development/testing.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Server-side only. Resend API key (https://resend.com/api-keys).
RESEND_API_KEY="your-resend-api-key"

# Optional: production site origin for the sitemap (e.g. https://heek-e.com).
# The sitemap only emits entries when this is set; no domain is hard-coded.
NEXT_PUBLIC_SITE_URL=""


